{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Knowledge Object",
  "type": "object",

  "required": [
    "knowledge_id",
    "claim_id",
    "prediction_id",
    "experiment_id",
    "evidence_id",
    "replication_id",
    "confidence",
    "reality_alignment",
    "status"
  ],

  "properties": {
    "knowledge_id": {
      "type": "string"
    },
    "claim_id": {
      "type": "string"
    },
    "prediction_id": {
      "type": "string"
    },
    "experiment_id": {
      "type": "string"
    },
    "evidence_id": {
      "type": "string"
    },
    "replication_id": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "reality_alignment": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "status": {
      "type": "string"
    }
  }
}
