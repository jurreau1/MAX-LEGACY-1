{
  "$schema": "https://json-schema.org/draft/2020-12/schema",

  "title": "Evolution Event",

  "type": "object",

  "required": [
    "event_id",
    "timestamp",
    "domain",
    "entity",
    "change_type"
  ],

  "properties": {

    "event_id": {
      "type": "string"
    },

    "timestamp": {
      "type": "string"
    },

    "domain": {
      "type": "string"
    },

    "entity": {
      "type": "string"
    },

    "change_type": {
      "type": "string"
    },

    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },

    "reality_alignment": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    }
  }
}
