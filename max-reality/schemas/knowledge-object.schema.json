{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://max-legacy.local/schemas/knowledge-object.json","title":"Knowledge Object","description":"Validated knowledge object with full provenance chain","type":"object","required":["knowledge_id","claim_id","prediction_id","experiment_id","evidence_id","replication_id","confidence","reality_alignment","status","created_at","updated_at"],"properties":{"knowledge_id":{"type":"string","pattern":"^K-[0-9]{3,}$","description":"Unique knowledge object identifier"},"claim_id":{"type":"string","description":"Reference to originating claim"},"prediction_id":{"type":"string","description":"Reference to testable prediction"},"experiment_id":{"type":"string","description":"Reference to structured experiment"},"evidence_id":{"type":"string","description":"Reference to observable evidence"},"replication_id":{"type":"string","description":"Reference to independent replication"},"confidence":{"type":"number","minimum":0,"maximum":100,"description":"Confidence score (0-100)"},"reality_alignment":{"type":"number","minimum":0,"maximum":100,"description":"Reality alignment score (0-100)"},"status":{"type":"string","enum":["claim","prediction","experiment","evidence","replication","knowledge"],"description":"Current lifecycle state"},"created_at":{"type":"string","format":"date-time","description":"Creation timestamp"},"updated_at":{"type":"string","format":"date-time","description":"Last update timestamp"},"domain":{"type":"string","description":"Associated domain (academic, research, validation, simulation, etc.)"},"description":{"type":"string","description":"Human-readable description"}},"additionalProperties":false}