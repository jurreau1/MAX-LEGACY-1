{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://max-legacy.local/schemas/evolution-event.json","title":"Evolution Event","description":"Immutable event record for knowledge promotion and domain evolution","type":"object","required":["event_id","timestamp","domain","entity_id","change_type","actor"],"properties":{"event_id":{"type":"string","pattern":"^EV-[0-9]{4,}$","description":"Unique event identifier"},"timestamp":{"type":"string","format":"date-time","description":"Event timestamp (ISO 8601)"},"domain":{"type":"string","enum":["academic","research","validation","simulation","governance","sports","finance","weather","games"],"description":"Domain where event occurred"},"entity_id":{"type":"string","description":"ID of entity being evolved (knowledge_id, replication_id, etc.)"},"change_type":{"type":"string","enum":["claim_created","prediction_promoted","experiment_executed","evidence_added","replication_confirmed","knowledge_validated"],"description":"Type of change event"},"actor":{"type":"string","description":"System or agent that triggered the event"},"from_state":{"type":"string","description":"Previous state (for promotion events)"},"to_state":{"type":"string","description":"New state (for promotion events)"},"confidence_before":{"type":"number","minimum":0,"maximum":100},"confidence_after":{"type":"number","minimum":0,"maximum":100},"reality_alignment_before":{"type":"number","minimum":0,"maximum":100},"reality_alignment_after":{"type":"number","minimum":0,"maximum":100},"validation_passed":{"type":"boolean","description":"Whether promotion validation passed"},"validation_details":{"type":"object","description":"Details of validation checks performed"}},"additionalProperties":false}